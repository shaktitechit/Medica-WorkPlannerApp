{
  "expo": {
    "name": "Medica Work Planner",
    "slug": "MedicaWorkPlanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "medicaworkplanner",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0f766e"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach receipts and plan files from your photo library."
      }
    },
    "android": {
      "permissions": [
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "in.medicaent.workplanner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    }
  }
}